<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.acmesoftware</groupId>
        <artifactId>acmemailtrap-parent</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>acmemailtrap-cli</artifactId>
    <packaging>jar</packaging>
    <name>ACMEmailtrap CLI</name>
    <description>Scriptable client for the trap: contexts, mailboxes, messages, and assertable waits (ADR-0002).</description>

    <properties>
        <picocli.version>4.7.6</picocli.version>
        <main.class>de.acmesoftware.mailtrap.cli.AcmeMailtrapCli</main.class>
    </properties>

    <!-- Deliberately no Spring: the CLI is a plain client over java.net.http, so it starts
         fast and stays a candidate for a GraalVM native image. -->
    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>acmemailtrap-cli</finalName>
        <plugins>
            <!-- picocli's annotation processor generates the reflection metadata; also the
                 basis for the native image (ADR-0002 slice 5). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Executable fat jar: java -jar cli/target/acmemailtrap-cli.jar. The Spring Boot
                 plugin is inherited from the parent; it repackages any main class (no Spring at
                 runtime here) and stamps Implementation-Version into the manifest. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <layout>JAR</layout>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Native binary (ADR-0002 slice 5): mvn -Pnative-image -pl cli package on a GraalVM JDK
          produces cli/target/acmemailtrap-cli, a self-contained ~20ms-start executable. picocli's
          annotation processor emits the reflection/resource config under META-INF/native-image; the
          hand-written reflect-config next to it covers the Jackson-mapped CliConfig classes.

          The profile is deliberately NOT named "native": the Spring Boot parent binds a Spring AOT
          step to a profile by that name, which fails here since the CLI is not a Spring application.
        -->
        <profile>
            <id>native-image</id>
            <build>
                <plugins>
                    <!-- Skip the Boot loader repackage for native builds: native-image needs the
                         plain jar (classes at the root), not the BOOT-INF/classes layout. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>acmemailtrap-cli</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-O2</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
