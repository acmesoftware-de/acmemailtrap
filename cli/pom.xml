<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.acmesoftware</groupId>
        <artifactId>acmemailtrap-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>acmemailtrap-cli</artifactId>
    <packaging>jar</packaging>
    <name>ACMEmailtrap CLI</name>
    <description>Scriptable client for the trap: contexts, mailboxes, messages, and assertable waits (ADR-0002).</description>

    <properties>
        <picocli.version>4.7.6</picocli.version>
        <main.class>de.acmesoftware.mailtrap.cli.AcmeMailtrapCli</main.class>
    </properties>

    <!-- Deliberately no Spring: the CLI is a plain client over java.net.http, so it starts
         fast and stays a candidate for a GraalVM native image. -->
    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>acmemailtrap-cli</finalName>
        <plugins>
            <!-- picocli's annotation processor generates the reflection metadata; also the
                 basis for the native image (ADR-0002 slice 5). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Executable fat jar: java -jar cli/target/acmemailtrap-cli.jar. The Spring Boot
                 plugin is inherited from the parent; it repackages any main class (no Spring at
                 runtime here) and stamps Implementation-Version into the manifest. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <layout>JAR</layout>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
