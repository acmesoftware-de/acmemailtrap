<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>de.acmesoftware</groupId>
    <artifactId>acmemailtrap-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ACMEmailtrap</name>
    <description>Email trap for testing ACMEsuite: catches SMTP, stores per recipient, serves IMAP and a React web UI, forwards via pluggable channels.</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <node.version>v22.12.0</node.version>
        <lucene.version>9.12.0</lucene.version>
        <!-- set -Dskip.frontend=true to build without the npm build -->
        <skip.frontend>false</skip.frontend>
    </properties>

    <modules>
        <module>plugin-api</module>
        <module>plugins</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.acmesoftware</groupId>
                <artifactId>acmemailtrap-plugin-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.acmesoftware</groupId>
                <artifactId>acmemailtrap-plugins</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.angus</groupId>
                <artifactId>angus-mail</artifactId>
                <version>2.0.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
